{
  "name": "the-one-engine-workspace",
  "private": true,
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "tdd": "vitest watch",
    "dev": "pnpm -r --parallel dev"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.5"
  }
}
